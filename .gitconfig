[alias]
    graph = log --decorate --oneline --graph
    shove = push --force-with-lease
    amend = commit --amend --no-edit
    fixup = commit --fixup
    co = checkout
[color]
    ui = true
[color "diff"]
    whitespace = red reverse
[help]
    autocorrect = 1
[core]
    excludesfile = ~/.gitignore.global
[include]
    path = ~/.gitconfig.user
[includeIf "gitdir:vtex/"]
    path = ~/.gitconfig.vtex.user
[includeIf "gitdir/i:c:/"]
    path = ~/.gitconfig.windows
[includeIf "gitdir/i:d:/"]
    path = ~/.gitconfig.windows
[includeIf "gitdir/i:/users/"]
    path = ~/.gitconfig.unix
[includeIf "gitdir/i:/home/"]
    path = ~/.gitconfig.unix
[pull]
    ff = only
[rebase]
    autosquash = true
[init]
    defaultBranch = main
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[user]
	name = Stanislav Hamara
	email = stanislav.hamara@docker.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEuES3tbFVGkntduroC0zialS8wdlqrwT3UTTLxYA5ky
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = /Users/stanislavhamara/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
